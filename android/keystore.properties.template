# Copy this file to android/keystore.properties and fill in your release key values.
# Do not commit android/keystore.properties to version control.

# Path to your release keystore file, relative to android/ or absolute.
storeFile=release-key.jks

# Password for the keystore file.
storePassword=YOUR_STORE_PASSWORD

# Alias for the private key inside the keystore.
keyAlias=YOUR_KEY_ALIAS

# Password for the key alias.
keyPassword=YOUR_KEY_PASSWORD
