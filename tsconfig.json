{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "vite.config.ts"],
  "exclude": ["**/node_modules", "**/Pods", "android", "android-rn"]
}
